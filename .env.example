# Casa Cheia — ambiente
# Copie pra .env (gitignored) e preencha. As vars marcadas REQUIRED são
# obrigatórias em produção; sem elas, o que depende delas fica silenciado
# (sem crash).

# --- Resend (admin notifications) ---
# Lina recebe email quando alguém reserva um presente. Cancelamentos também.
RESEND_API_KEY=                    # REQUIRED em prod (sem isso, admin não recebe email)
RESEND_FROM_EMAIL=Casa Cheia <onboarding@resend.dev>
ADMIN_EMAIL_NOTIFY=matheus.thosi@gmail.com

# --- Evolution API (WhatsApp lembrete + agradecimento) ---
# Quando ausente, o painel mostra aviso "API não configurada" e os disparos
# ficam silenciosos (não envia, mas não quebra o site).
EVOLUTION_API_URL=                 # ex: https://evo.matheus.dev   (sem barra no fim)
EVOLUTION_API_KEY=                 # token global da instância
EVOLUTION_INSTANCE_NAME=           # nome da instância conectada (ex: casacheia, ou reusa do ws-evolution)

# --- Netlify (já configurado pelo build) ---
# Blobs + Identity vêm do contexto Netlify; não precisa setar aqui.
