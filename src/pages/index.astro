---
import Base from '~/layouts/Base.astro';
import HeroScene from '~/components/animation/HeroScene';
import { getSettings, formatEventDate } from '~/lib/settings';

const settings = getSettings();
const eventDateLong = formatEventDate(settings.event_date);
---

<Base title={`Casa Cheia — chá da ${settings.bride_name}`}>

  <!-- HERO MOBILE: scene full-bleed top, text below -->
  <section class="lg:hidden">
    <div class="relative aspect-[864/1085] bg-white max-h-[65vh] mx-auto" style="width: min(100%, calc(65vh * 864 / 1085));">
      <HeroScene client:load brideName={settings.bride_name} />
    </div>

    <div class="px-5 py-7 border-t border-line">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-primary-t text-primary-h text-[11px] font-semibold uppercase tracking-wider mb-4">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9 12 2l9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        chá de casa nova
      </div>
      <h1 class="text-[34px] leading-[1.1] font-bold text-ink tracking-tight">
        Ajude a <span class="font-display italic font-medium text-primary">{settings.bride_name}</span> a deixar o apê cheinho.
      </h1>
      <p class="mt-3 text-[15px] text-ink-soft leading-relaxed">{settings.splash_subtitle}</p>
      <div class="mt-5 flex flex-col gap-2.5">
        <a href="/presentes" class="h-12 rounded-xl bg-primary hover:bg-primary-h active:bg-primary-p text-white font-semibold text-[15px] transition shadow-sm flex items-center justify-center gap-2">
          Ver presentes
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#how" class="h-12 rounded-xl bg-white border border-line text-ink font-semibold text-[15px] transition flex items-center justify-center gap-2 hover:bg-line-2">Como funciona</a>
      </div>
      <div class="mt-7 grid grid-cols-3 gap-2 text-center">
        <div class="py-3 rounded-xl bg-line-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mx-auto mb-1 text-primary"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <div class="text-[10px] uppercase tracking-wider text-ink-3 font-semibold">Data</div>
          <div class="text-xs font-semibold text-ink mt-0.5">{settings.event_date.split('-').reverse().slice(0,2).join('/')}</div>
        </div>
        <div class="py-3 rounded-xl bg-line-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mx-auto mb-1 text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div class="text-[10px] uppercase tracking-wider text-ink-3 font-semibold">Hora</div>
          <div class="text-xs font-semibold text-ink mt-0.5">{settings.event_time}</div>
        </div>
        <div class="py-3 rounded-xl bg-line-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mx-auto mb-1 text-primary"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div class="text-[10px] uppercase tracking-wider text-ink-3 font-semibold">Local</div>
          <div class="text-xs font-semibold text-ink mt-0.5">Apê novo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO DESKTOP -->
  <section class="hidden lg:block">
    <div class="max-w-7xl mx-auto px-8 pt-12 pb-20 grid grid-cols-12 gap-10 items-center">
      <div class="col-span-5 relative z-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary-t text-primary-h text-xs font-semibold uppercase tracking-wider mb-5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9 12 2l9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          chá de casa nova
        </div>
        <h1 class="text-[64px] leading-[1.05] font-bold text-ink tracking-tight">
          Ajude a <span class="font-display italic font-medium text-primary">{settings.bride_name}</span><br />
          a deixar o<br />apê cheinho.
        </h1>
        <p class="mt-5 text-lg text-ink-soft max-w-md leading-relaxed">{settings.splash_subtitle}</p>
        <div class="mt-7 flex gap-3">
          <a href="/presentes" class="h-12 px-7 rounded-xl bg-primary hover:bg-primary-h active:bg-primary-p text-white font-semibold transition shadow-sm flex items-center justify-center gap-2 group">
            Ver presentes
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-0.5 transition"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="#how" class="h-12 px-7 rounded-xl bg-white border border-line hover:border-ink text-ink font-semibold transition flex items-center justify-center gap-2">Como funciona</a>
        </div>
        <div class="mt-10 flex flex-wrap gap-5 text-sm text-ink-soft">
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>{eventDateLong}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>{settings.event_time}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{settings.event_address}</span>
          </div>
        </div>
      </div>

      <div class="col-span-7 relative">
        <div class="relative aspect-[864/1085] bg-white rounded-3xl shadow-md border border-line overflow-hidden">
          <HeroScene client:load brideName={settings.bride_name} />
        </div>
      </div>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section id="how" class="bg-line-2 py-14 lg:py-20">
    <div class="max-w-5xl mx-auto px-5 lg:px-8">
      <div class="text-center mb-10">
        <div class="text-[11px] uppercase tracking-widest text-primary-h font-bold mb-2">como funciona</div>
        <h2 class="text-3xl lg:text-4xl font-bold text-ink tracking-tight">Em 2 passos, do clique ao presente.</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-3 lg:gap-5">
        <div class="bg-white rounded-2xl p-6 border border-line">
          <div class="w-11 h-11 rounded-xl bg-primary-t text-primary-h grid place-items-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 14h2a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>
          </div>
          <div class="text-[11px] uppercase tracking-wider text-ink-3 font-bold mb-1.5">passo 01</div>
          <h3 class="text-lg font-semibold text-ink mb-1.5">Escolhe um presente</h3>
          <p class="text-sm text-ink-soft leading-relaxed">Navega na lista, filtra por cômodo ou preço, e marca o que vai trazer.</p>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-line">
          <div class="w-11 h-11 rounded-xl bg-success-s text-success grid place-items-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="text-[11px] uppercase tracking-wider text-ink-3 font-bold mb-1.5">passo 02</div>
          <h3 class="text-lg font-semibold text-ink mb-1.5">Confirma e compra na hora</h3>
          <p class="text-sm text-ink-soft leading-relaxed">Põe seu nome, confirma a reserva e a gente já te leva pra página da Amazon. Compra direto por lá.</p>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="/presentes" class="inline-flex h-12 px-7 rounded-xl bg-ink hover:bg-ink-2 text-white font-semibold transition items-center gap-2">
          Bora escolher
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js" defer></script>
</Base>
